<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately identical to values/colors.xml: the black background +
    yellow accent brand palette is fixed, not light/dark-adaptive, so this
    file exists only to make sure the system's night mode can't reintroduce
    a different color set. See values/colors.xml for the full rationale.
-->
