    <color name="md_theme_onPrimary">#1A1A1A</color>
    <color name="md_theme_secondary">#FFB300</color>
    <color name="md_theme_onSecondary">#1A1A1A</color>
    <color name="md_theme_background">#000000</color>
    <color name="md_theme_onBackground">#F5F5F0</color>
    <color name="md_theme_surface">#1C1C1C</color>
    <color name="md_theme_onSurface">#F5F5F0</color>
    <color name="md_theme_surfaceVariant">#262626</color>
    <color name="md_theme_onSurfaceVariant">#B3B3B0</color>
    <color name="md_theme_outline">#3A3A3A</color>
</resources>
