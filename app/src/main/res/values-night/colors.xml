<?xml version="1.0" encoding="utf-8"?>
<!--
    md_theme_*: deliberately identical to values/colors.xml. The black
    background + yellow accent brand palette used by Theme.HackersKeyboard
    (Settings, panels) is fixed, not light/dark-adaptive, so this file exists
    only to make sure the system's night mode can't reintroduce a different
    color set there. See values/colors.xml for the full rationale.

    setup_*: the OPPOSITE is true here on purpose: Theme.HackersKeyboard.Main
    (the Home screen only) is properly day/night-adaptive, matching the
    reference app it's built from (github.com/jcb1ee/hackerskeyboard2). These
    values are its dark-mode side.
-->
<resources>
    <color name="md_theme_primary">#F5C400</color>
    <color name="md_theme_onPrimary">#000000</color>
    <color name="md_theme_secondary">#FFB300</color>
    <color name="md_theme_onSecondary">#1A1A1A</color>
    <color name="md_theme_background">#000000</color>
    <color name="md_theme_onBackground">#FFFFFF</color>
    <color name="md_theme_surface">#0D0D0D</color>
    <color name="md_theme_onSurface">#FFFFFF</color>
    <color name="md_theme_surfaceVariant">#262626</color>
    <color name="md_theme_onSurfaceVariant">#A8A8A8</color>
    <color name="md_theme_outline">#262626</color>

    <color name="setup_primary">#3E5C76</color>
    <color name="setup_on_primary">#F0EBD8</color>
    <color name="setup_bg">#0D1321</color>
    <color name="setup_surface">#1D2D44</color>
    <color name="setup_text_primary">#F0EBD8</color>
    <color name="setup_text_secondary">#748CAB</color>
    <color name="setup_text_muted">#3E5C76</color>
</resources>
