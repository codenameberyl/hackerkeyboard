<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App-wide theme for the "chrome" activities (Main, LatinIMESettings,
         InputLanguageSelection, PrefScreen*); the actual keyboard is drawn
         by LatinKeyboardBaseView and skinned separately via the
         key*Material* colors below / the user's keyboard-theme preference.

         A fixed black background + yellow accent brand palette, not a
         light/dark-adaptive Material3 scheme: every color token below is
         overridden explicitly, and values/colors.xml + values-night/colors.xml
         intentionally define the same values, so the result looks identical
         regardless of the system's day/night setting (or Material You
         dynamic color, which HackersKeyboardApplication does not apply to
         these Activities for the same reason). -->
    <style name="Theme.HackersKeyboard" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="android:windowBackground">@color/md_theme_background</item>
        <!-- The legacy android.preference.PreferenceActivity screens (LatinIMESettings
             and friends) aren't insets-aware code; without this, their content can end
             up drawn underneath the status bar (title bar and the first row/category
             overlapping the clock/battery) on some Android versions/OEM skins despite
             the manifest's windowOptOutEdgeToEdgeEnforcement. This restores the
             classic, well-established "let the system pad my content for the status/
             nav bars automatically" behavior. -->
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!-- Home screen (Main activity) only: the reference design this screen is
         built from (github.com/jcb1ee/hackerskeyboard2's Theme.HackersKeyboard.Main)
         uses a properly day/night-adaptive navy/cream palette, deliberately
         different from the rest of this app's fixed black/yellow chrome above.
         Kept scoped to Main via the manifest's per-activity android:theme
         rather than replacing Theme.HackersKeyboard app-wide. NoActionBar
         because the reference's Home screen has no native title bar; main.xml
         already renders its own header (icon + app name + tagline), so one
         would just be a redundant duplicate. -->
    <style name="Theme.HackersKeyboard.Main" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/setup_primary</item>
        <item name="colorOnPrimary">@color/setup_on_primary</item>
        <item name="android:colorBackground">@color/setup_bg</item>
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="colorSurface">@color/setup_surface</item>
        <item name="colorOnSurface">@color/setup_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/setup_text_secondary</item>
        <item name="colorOnBackground">@color/setup_text_primary</item>
        <item name="colorOutline">@color/setup_text_muted</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
