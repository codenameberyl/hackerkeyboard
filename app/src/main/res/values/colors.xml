<!--
    App chrome theme colors (Theme.HackersKeyboard): a deliberate fixed
    black background + yellow accent brand palette for the Home and
    Settings screens, not a light/dark-adaptive Material3 scheme. This
    file and values-night/colors.xml define the *same* colors on purpose,
    so the app looks identical regardless of the system's day/night
    setting. (Material You dynamic color is not applied to these
    Activities for the same reason; see HackersKeyboardApplication.)

    This is separate from the keyboard's own key-drawing skin, which the
    user can still customize independently via "Theme and label
    settings" (key_*_material_* above, and values-v31/colors.xml).
-->
    <color name="md_theme_primary">#F5C400</color>
    <color name="md_theme_onPrimary">#000000</color>
    <color name="md_theme_secondary">#FFB300</color>
    <color name="md_theme_onSecondary">#1A1A1A</color>
    <color name="md_theme_background">#000000</color>
    <color name="md_theme_onBackground">#FFFFFF</color>
    <color name="md_theme_surface">#0D0D0D</color>
    <color name="md_theme_onSurface">#FFFFFF</color>
    <color name="md_theme_surfaceVariant">#262626</color>
    <color name="md_theme_onSurfaceVariant">#A8A8A8</color>
    <color name="md_theme_outline">#262626</color>

    <!-- Home screen (Main activity) only palette: see Theme.HackersKeyboard.Main
         in themes.xml. Exact values from the reference app this screen is built
         from (github.com/jcb1ee/hackerskeyboard2), light-mode side; the dark-mode
         side is in values-night/colors.xml. Deliberately day/night-adaptive,
         unlike the fixed md_theme_* palette above. -->
    <color name="setup_primary">#1D2D44</color>
    <color name="setup_on_primary">#F0EBD8</color>
    <color name="setup_bg">#F0EBD8</color>
    <color name="setup_surface">#FFFFFF</color>
    <color name="setup_text_primary">#0D1321</color>
    <color name="setup_text_secondary">#3E5C76</color>
    <color name="setup_text_muted">#748CAB</color>
</resources>
