<?xml version="1.0" encoding="utf-8"?>
<!-- Border for the Home screen header icon (see main.xml): transparent fill,
     a thin outline around the app icon; "setup_icon_border" in the
     reference app this screen is built from
     (github.com/jcb1ee/hackerskeyboard2). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
        android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="?attr/colorOutline" />
</shape>
